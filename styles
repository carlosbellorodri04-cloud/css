* {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
}

:root {
    --color: rgb(227, 14, 14);
    --color2: rgb(15, 34, 204);
    --color3: rgb(9, 2, 21);
    --color4: rgb(210, 201, 201);
    --color5: rgb(28, 156, 199);
    --front-size: 30px;
    --padding-top: 25px;
    --padding-bottom: 25px;
    --padding-right: 18px;
    --padding-left: 18px; 
}

body {
    font-family: sans-serif;
    background-color: var(--color3);
    color: var(--color4);
    line-height: 1.6;
}

header {
    background-color: var(--color3);
    background-image: url("https://images.unsplash.com/photo-1617814076367-b759c7d7e738?q=80&w=1200&auto=format&fit=crop");
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
    height: 280px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    text-align: center;
    border-bottom: 4px solid var(--color);
}

header h1 {
    color: var(--color);
    font-size: var(--front-size);
    text-shadow: 2px 2px 6px rgba(0, 0, 0, 0.9);
    margin-bottom: 5px;
}

header p {
    color: #ffffff;
    font-size: 1.2rem;
    font-weight: bold;
    text-shadow: 1px 1px 4px rgba(0, 0, 0, 0.9);
}

main {
    background-color: #151026; /* Un tono ligeramente más claro que el body para destacar */
    max-width: 900px;
    margin: 25px auto;
    padding-top: var(--padding-top);
    padding-bottom: var(--padding-bottom);
    padding-right: var(--padding-right);
    padding-left: var(--padding-left);
    border: 2px solid var(--color2); /* Marco azul llamativo para el contenedor principal */
    border-radius: 8px;
}

.titulo-seccion {
    color: var(--color5);
    margin-bottom: 20px;
    font-size: 1.8rem;
    border-bottom: 2px solid var(--color5);
    padding-bottom: 8px;
}

aside {
    background-color: #1a1236;
    padding-top: var(--padding-top);
    padding-bottom: var(--padding-bottom);
    padding-right: var(--padding-right);
    padding-left: var(--padding-left);
    border: 2px solid var(--color5);
    margin-top: 30px;
    border-radius: 6px;
}

aside h3 {
    color: var(--color5);
    margin-bottom: 10px;
}

footer {
    background-color: var(--color3);
    color: var(--color4);
    text-align: center;
    padding-top: var(--padding-top);
    padding-bottom: var(--padding-bottom);
    padding-right: var(--padding-right);
    padding-left: var(--padding-left);
    margin-top: 40px;
    border-top: 3px solid var(--color);
}

footer a {
    color: var(--color5);
    text-decoration: none;
}

.enlace-comprar {
    color: #ffffff;
    background-color: var(--color2);
    padding: 8px 15px;
    border-radius: 4px;
    text-decoration: none;
    font-weight: bold;
    display: inline-block;
}

.enlace-comprar:hover {
    background-color: var(--color);
}

a:hover {
    text-decoration: underline;
}

/* Tarjetas de productos con colores vivos y estructura definida */
.producto {
    padding-top: var(--padding-top);
    padding-bottom: var(--padding-bottom);
    padding-right: var(--padding-right);
    padding-left: var(--padding-left);
    margin: 25px 0;
    border: 2px solid var(--color5); /* Borde azul claro para que resalte la caja */
    background-color: #1f163b; /* Fondo sutil con color para que no se vea vacío */
    color: var(--color4);
    border-radius: 8px;
    box-shadow: 0 4px 10px rgba(0, 0, 0, 0.4);
}

.producto img {
    width: 100%;
    max-height: 350px;
    object-fit: cover;
    border-radius: 6px;
    margin-bottom: 15px;
    border: 1px solid var(--color4);
}

.producto h3 {
    color: var(--color5);
    font-size: 1.5rem;
    margin-bottom: 10px;
}

.producto p {
    margin-bottom: 12px;
}

.producto h4 {
    color: #ffffff;
    margin-top: 15px;
    margin-bottom: 5px;
}

.producto ul {
    margin-bottom: 15px;
    padding-left: 20px;
}

.contenedor-precio {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-top: 15px;
    padding-top: 12px;
    border-top: 1px solid rgba(28, 156, 199, 0.4);
}

.producto .precio {
    color: #4ade80; /* Verde brillante para el precio */
    font-size: 1.4rem;
    font-weight: bold;
}

.categorias ul {
    list-style: none;
    padding-left: 0;
}

.categorias ul li {
    margin: 6px 0;
}

.categorias ul li a {
    color: var(--color4);
    text-decoration: none;
    font-weight: 500;
}

.categorias ul li a:hover {
    color: var(--color);
    text-decoration: underline;
}